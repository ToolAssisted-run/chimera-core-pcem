  "machineSetting": "preset",
  "_machines_note": "The presets are TASVideos' published configurations. They are machines[] entries whose settingOverrides change DEFAULTS only - every machine, card and drive stays selectable under any of them, and 'custom' overrides nothing. This is a general PC, not an XP appliance.",
  "machines": [
    {
      "id": "custom",
      "label": "Custom",
      "when": [
        "custom"
      ]
    },
    {
      "id": "dos-late80s",
      "label": "DOS, late 1980s (Compaq Deskpro 386)",
      "when": [
        "dos-late80s"
      ],
      "settingOverrides": {
        "machine": {
          "default": "deskpro386"
        },
        "cpu": {
          "default": 0
        },
        "memSizeKB": {
          "default": 4096
        },
        "videoCard": {
          "default": "vga"
        },
        "soundCard": {
          "default": "sbpro2"
        },
        "dynarec": {
          "default": false
        },
        "hddController": {
          "default": "ide"
        },
        "mouseType": {
          "default": 0
        }
      }
    },
    {
      "id": "dos-early90s",
      "label": "DOS, early 1990s (Packard Bell PB570)",
      "when": [
        "dos-early90s"
      ],
      "settingOverrides": {
        "machine": {
          "default": "pb570"
        },
        "memSizeKB": {
          "default": 8192
        },
        "videoCard": {
          "default": "builtin"
        },
        "soundCard": {
          "default": "sb16"
        },
        "dynarec": {
          "default": true
        },
        "hddController": {
          "default": "ide"
        },
        "mouseType": {
          "default": 2
        }
      }
    },
    {
      "id": "dos-late90s",
      "label": "DOS, late 1990s (Gigabyte GA-686BX)",
      "when": [
        "dos-late90s"
      ],
      "settingOverrides": {
        "machine": {
          "default": "ga686bx"
        },
        "cpu": {
          "default": 6
        },
        "memSizeKB": {
          "default": 32768
        },
        "videoCard": {
          "default": "px_trio64"
        },
        "voodoo": {
          "default": true
        },
        "soundCard": {
          "default": "sb16"
        },
        "dynarec": {
          "default": true
        },
        "hddController": {
          "default": "ide"
        },
        "mouseType": {
          "default": 2
        }
      }
    },
    {
      "id": "win95",
      "label": "Windows 95 (Gigabyte GA-686BX)",
      "when": [
        "win95"
      ],
      "settingOverrides": {
        "machine": {
          "default": "ga686bx"
        },
        "cpu": {
          "default": 0
        },
        "memSizeKB": {
          "default": 262144
        },
        "videoCard": {
          "default": "v3_3000"
        },
        "soundCard": {
          "default": "sb16"
        },
        "dynarec": {
          "default": true
        },
        "hddController": {
          "default": "ide"
        },
        "mouseType": {
          "default": 2
        }
      }
    },
    {
      "id": "winxp",
      "label": "Windows XP (Gigabyte GA-686BX)",
      "when": [
        "winxp"
      ],
      "settingOverrides": {
        "machine": {
          "default": "ga686bx"
        },
        "cpu": {
          "default": 6
