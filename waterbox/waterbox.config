  "settings": [
    {
      "name": "preset",
      "display": "Configuration",
      "type": "enum",
      "options": [
        "custom",
        "dos-late80s",
        "dos-early90s",
        "dos-late90s",
        "win95",
        "winxp"
      ],
      "default": "custom",
      "description": "A starting point. Each preset is one of the configurations TASVideos publishes, and sets the machine, CPU, memory, video and sound below; 'custom' leaves them alone. Changing anything afterwards is fine - the preset only supplies defaults."
    },
    {
